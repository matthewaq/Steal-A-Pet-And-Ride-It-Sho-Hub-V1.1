-- rarities (common game order + extras)
local RARITIES = {
    "Common", "Uncommon", "Rare", "Epic", "Legendary",
    "Mythic", "Secret", "Limited", "Cosmic", "Divine", "Singularity","Eternal",
}

local F = {
    Grab = false, Train = false, Upgrade = false, Collect = false,
    SpeedLoop = false, InfJump = false, Noclip = false, AntiAFK = true,
    WalkSpeed = 16,
    Rarity = {}, -- name -> bool
}
for _, r in ipairs(RARITIES) do
    F.Rarity[r] = true -- default: all on
end

local Conns = {}

LP.Idled:Connect(function()
    if F.AntiAFK then
        pcall(function()
            S.VU:CaptureController()
            S.VU:ClickButton2(Vector2.new())
        end)
    end
end)

local function hrp()
    if not HRP or not HRP.Parent then pcall(pullChar) end
    return HRP
end

local function fireP(p)
    if not p or not p.Parent then return end
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(p)
        else
            p:InputHoldBegin()
            task.wait((p.HoldDuration and p.HoldDuration > 0) and p.HoldDuration or 0.05)
            p:InputHoldEnd()
        end
    end)
end

local function fireC(d)
    if not d or not d.Parent then return end
    pcall(function()
        if fireclickdetector then fireclickdetector(d) end
    end)
end

local BLOCK = { "gamepass", "pass", "robux", "purchase", "buy pass", "product", "donate", "vip", "premium", "shop", "store", "gift" }
local GRAB = { "steal", "grab", "cage", "take cage", "pick up", "pick" }
local TRAIN = { "train", "treadmill", "speed", "workout" }
local UP = { "upgrade", "buy upgrade" }
local COL = { "collect", "cash", "claim", "money" }

local function hasAny(s, list)
    s = string.lower(tostring(s or ""))
    for i = 1, #list do
        if string.find(s, list[i], 1, true) then return true end
    end
    return false
end

local function isBlocked(p)
    local a, n, o = p.ActionText or "", p.Name or "", p.ObjectText or ""
    if hasAny(a, BLOCK) or hasAny(n, BLOCK) or hasAny(o, BLOCK) then return true end
    local cur, depth = p.Parent, 0
    while cur and depth < 5 do
        if hasAny(cur.Name, BLOCK) then return true end
        cur = cur.Parent
        depth += 1
    end
    return false
end

-- detect rarity from prompt + parent chain + nearby text labels
local function detectRarity(inst)
    local blob = ""
    local function add(s)
        if s and s ~= "" then blob = blob .. " " .. string.lower(tostring(s)) end
    end
    if inst:IsA("ProximityPrompt") then
        add(inst.ActionText) add(inst.ObjectText) add(inst.Name)
    end
    local cur, depth = inst, 0
    while cur and depth < 6 do
        add(cur.Name)
        for _, ch in ipairs(cur:GetChildren()) do
            if ch:IsA("StringValue") then add(ch.Value) end
            if ch:IsA("TextLabel") or ch:IsA("TextButton") then add(ch.Text) end
            if ch:IsA("BillboardGui") or ch:IsA("SurfaceGui") then
                for _, t in ipairs(ch:GetDescendants()) do
                    if t:IsA("TextLabel") or t:IsA("TextButton") then add(t.Text) end
                end
            end
        end
        cur = cur.Parent
        depth += 1
    end
    -- longest rarity name first so "Legendary" wins over "Rare" if both appear
    local order = {
        "singularity", "divine", "cosmic", "limited", "secret","Eternal",
        "mythic", "legendary", "epic", "rare", "uncommon", "common",
    }
    local map = {
        singularity = "Singularity", divine = "Divine", cosmic = "Cosmic",
        limited = "Limited", secret = "Secret", mythic = "Mythic",
        legendary = "Legendary", epic = "Epic", rare = "Rare",
        uncommon = "Uncommon", common = "Common",
    }
    for _, key in ipairs(order) do
        if string.find(blob, key, 1, true) then
            return map[key]
        end
    end
    return nil -- unknown
end

local function rarityAllowed(r)
    if not r then
        -- unknown: steal only if every rarity is on (treat as "any")
        for _, name in ipairs(RARITIES) do
            if not F.Rarity[name] then return false end
        end
        return true
    end
    return F.Rarity[r] == true
end

local function isGrabPrompt(p)
    if isBlocked(p) then return false end
    local a, n, o = p.ActionText or "", p.Name or "", p.ObjectText or ""
    if not (hasAny(a, GRAB) or hasAny(n, GRAB) or hasAny(o, GRAB)) then return false end
    local r = detectRarity(p)
    return rarityAllowed(r)
end

local cache = { prompts = {}, clicks = {}, t = 0 }
local function refreshCache()
    local now = os.clock()
    if now - cache.t < 2 then return end
    cache.t = now
    local pr, cl = {}, {}
    for _, o in ipairs(S.WS:GetDescendants()) do
        if o:IsA("ProximityPrompt") then table.insert(pr, o)
        elseif o:IsA("ClickDetector") then table.insert(cl, o) end
    end
    cache.prompts = pr
    cache.clicks = cl
end

