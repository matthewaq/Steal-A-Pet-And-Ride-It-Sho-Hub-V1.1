sec(FarmP, "AUTO")
tog(FarmP, "Auto Grab Cages", "Grab", function(on)
    if not on then return end
    task.spawn(function()
        while F.Grab do
            refreshCache()
            local h = hrp()
            for _, p in ipairs(cache.prompts) do
                if not F.Grab then break end
                if isGrabPrompt(p) then
                    local part = p.Parent
                    if part and part:IsA("BasePart") and h then
                        if (part.Position - h.Position).Magnitude < 90 then
                            fireP(p)
                        end
                    else
                        fireP(p)
                    end
                end
            end
            for _, d in ipairs(cache.clicks) do
                if not F.Grab then break end
                if d.Parent and hasAny(d.Parent.Name, GRAB) and not hasAny(d.Parent.Name, BLOCK) then
                    local r = detectRarity(d)
                    if rarityAllowed(r) then fireC(d) end
                end
            end
            task.wait(0.4 + math.random() * 0.25)
        end
    end)
end)

sec(FarmP, "RARITIES TO STEAL")
btn(FarmP, "All Rarities ON", function()
    for _, r in ipairs(RARITIES) do F.Rarity[r] = true end
    -- refresh page buttons by rebuilding is heavy; user toggles reflect on next open / accept state in F
end)
btn(FarmP, "All Rarities OFF", function()
    for _, r in ipairs(RARITIES) do F.Rarity[r] = false end
end)
for _, r in ipairs(RARITIES) do
    rarityTog(FarmP, r)
end

sec(FarmP, "OTHER")
tog(FarmP, "Auto Train", "Train", function(on)
    if not on then return end
    task.spawn(function()
        while F.Train do
            refreshCache()
            for _, p in ipairs(cache.prompts) do
                if not F.Train then break end
                if not isBlocked(p) and hasAny(p.ActionText, TRAIN) then fireP(p) end
            end
            task.wait(0.28 + math.random() * 0.15)
        end
    end)
end)
tog(FarmP, "Auto Upgrade", "Upgrade", function(on)
    if not on then return end
    task.spawn(function()
        while F.Upgrade do
            refreshCache()
            for _, p in ipairs(cache.prompts) do
                if not F.Upgrade then break end
                if not isBlocked(p) and hasAny(p.ActionText, UP) then fireP(p) end
            end
            task.wait(0.7 + math.random() * 0.3)
        end
    end)
end)
tog(FarmP, "Auto Collect Cash", "Collect", function(on)
    if not on then return end
    task.spawn(function()
        while F.Collect do
            refreshCache()
            for _, p in ipairs(cache.prompts) do
                if not F.Collect then break end
                if not isBlocked(p) and hasAny(p.ActionText, COL) then fireP(p) end
            end
            task.wait(0.85 + math.random() * 0.3)
        end
    end)
end)
btn(FarmP, "Collect Once", function()
    refreshCache()
    for _, p in ipairs(cache.prompts) do
        if not isBlocked(p) and hasAny(p.ActionText, COL) then fireP(p) end
    end
end)

sec(SpeedP, "MOVEMENT")
sld(SpeedP, "WalkSpeed", 16, 300, 16, "WalkSpeed", function(v)
    if Hum and Hum.Parent then Hum.WalkSpeed = v end
end)
tog(SpeedP, "Speed Boost Loop", "SpeedLoop", function(on)
    if not on then return end
    task.spawn(function()
        while F.SpeedLoop do
            if Hum and Hum.Parent then Hum.WalkSpeed = F.WalkSpeed end
            task.wait(0.2)
        end
        if Hum and Hum.Parent then Hum.WalkSpeed = 16 end
    end)
end)
tog(SpeedP, "Infinite Jump", "InfJump", function(on)
    if on then
        Conns.InfJump = S.UIS.JumpRequest:Connect(function()
            if F.InfJump and Hum and Hum.Parent then
                Hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    elseif Conns.InfJump then
        Conns.InfJump:Disconnect() Conns.InfJump = nil
    end
end)
tog(SpeedP, "Noclip", "Noclip", function(on)
    if on then
        Conns.Noclip = S.RS.Stepped:Connect(function()
            if F.Noclip and Char then
                for _, p in ipairs(Char:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
        end)
    elseif Conns.Noclip then
        Conns.Noclip:Disconnect() Conns.Noclip = nil
    end
end)

sec(PlayerP, "UTILITY")
tog(PlayerP, "Anti AFK", "AntiAFK", function() end)
btn(PlayerP, "Reset Character", function()
    if Hum and Hum.Parent then Hum.Health = 0 end
end)
btn(PlayerP, "Rejoin", function()
    pcall(function() S.TP:Teleport(game.PlaceId, LP) end)
end)

sec(TeleP, "ZONES")
local Zones = {
    "Mushroom Garden","Honey Meadow","Jungle Ruins","Dino Valley","Snowy Peaks",
    "Desert Pyramids","Candy Kingdom","Volcano","Sky Kingdom","Outer Space",
    "Moon Base","Red Planet","Ocean Planet","Crystal","Shadow","Storm","Black Hole",
}
for _, z in ipairs(Zones) do
    btn(TeleP, z, function()
        local h = hrp()
        if not h then return end
        local key = string.lower(z):sub(1, 5)
        for _, o in ipairs(S.WS:GetDescendants()) do
            if o:IsA("BasePart") and string.find(string.lower(o.Name), key, 1, true) then
                h.CFrame = o.CFrame + Vector3.new(0, 5, 0)
                break
            end
        end
    end)
end
sec(TeleP, "QUICK")
btn(TeleP, "Barn / Base", function()
    local h = hrp()
    if not h then return end
    for _, o in ipairs(S.WS:GetDescendants()) do
        if o:IsA("BasePart") then
            local n = string.lower(o.Name)
            if n:find("barn") or n:find("base") or n:find("home") or n:find("plot") then
                h.CFrame = o.CFrame + Vector3.new(0, 5, 0)
                return
            end
        end
    end
end)

sec(MiscP, "EXTRA")
btn(MiscP, "FPS Boost", function()
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
end)
btn(MiscP, "Copy PlaceId", function()
    if setclipboard then setclipboard(tostring(game.PlaceId)) end
end)

show("Main")
for _, c in ipairs(side:GetChildren()) do
    if c:IsA("TextButton") and c.Text == "Main" then c.BackgroundColor3 = Color3.fromRGB(50, 45, 80) end
end

-- floating toggle
local fab = Instance.new("TextButton")
fab.Name = rn(8)
fab.Size = UDim2.new(0, isMobile and 48 or 44, 0, isMobile and 48 or 44)
fab.Position = UDim2.new(1, isMobile and -60 or -56, 0.5, -22)
fab.BackgroundColor3 = Color3.fromRGB(70, 55, 140)
fab.Text = "SF"
fab.TextColor3 = Color3.fromRGB(255, 255, 255)
fab.TextSize = 14
fab.Font = Enum.Font.GothamBold
fab.Parent = gui
Instance.new("UICorner", fab).CornerRadius = UDim.new(1, 0)
local fabStroke = Instance.new("UIStroke")
fabStroke.Color = Color3.fromRGB(120, 100, 200)
fabStroke.Thickness = 1
fabStroke.Parent = fab

local function setMenu(vis) main.Visible = vis end
setMenu(true)
fab.MouseButton1Click:Connect(function() setMenu(not main.Visible) end)
close.MouseButton1Click:Connect(function() setMenu(false) end)

local dragging, d0, p0
header.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging = true d0 = i.Position p0 = main.Position
    end
end)
header.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)
S.UIS.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - d0
        main.Position = UDim2.new(p0.X.Scale, p0.X.Offset + d.X, p0.Y.Scale, p0.Y.Offset + d.Y)
    end
end)

local fd, fd0, fp0
fab.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        fd = true fd0 = i.Position fp0 = fab.Position
    end
end)
fab.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then fd = false end
end)
S.UIS.InputChanged:Connect(function(i)
    if fd and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - fd0
        fab.Position = UDim2.new(fp0.X.Scale, fp0.X.Offset + d.X, fp0.Y.Scale, fp0.Y.Offset + d.Y)
    end
end)

S.UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.K then setMenu(not main.Visible) end
end)
