-- ShoField • rarity-filtered auto grab • mobile • floating toggle
-- Xeno / Solara / Real / Delta / Krnl

local function rn(n)
    local c = "Il1O0abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local s = ""
    for i = 1, (n or 10) do
        local j = math.random(1, #c)
        s = s .. c:sub(j, j)
    end
    return s
end

task.wait(0.4 + math.random() * 0.7)

local ALLOWED = { xeno = true, solara = true, real = true, delta = true, krnl = true, ["krnl.exe"] = true }

local function execName()
    local n = "Unknown"
    pcall(function()
        if identifyexecutor then n = identifyexecutor()
        elseif getexecutorname then n = getexecutorname() end
    end)
    return tostring(n)
end

local detected = execName()
local low = string.lower(detected)
local allowed = false
for k in pairs(ALLOWED) do
    if string.find(low, k, 1, true) then allowed = true break end
end

local S = {
    Players = game:GetService("Players"),
    RS = game:GetService("RunService"),
    UIS = game:GetService("UserInputService"),
    TS = game:GetService("TweenService"),
    VU = game:GetService("VirtualUser"),
    WS = game:GetService("Workspace"),
    CG = game:GetService("CoreGui"),
    TP = game:GetService("TeleportService"),
}

local LP = S.Players.LocalPlayer
local Char, Hum, HRP
local isMobile = S.UIS.TouchEnabled and not S.UIS.KeyboardEnabled

local function pullChar()
    Char = LP.Character or LP.CharacterAdded:Wait()
    Hum = Char:FindFirstChildOfClass("Humanoid") or Char:WaitForChild("Humanoid", 8)
    HRP = Char:FindFirstChild("HumanoidRootPart") or Char:WaitForChild("HumanoidRootPart", 8)
end
pcall(pullChar)
LP.CharacterAdded:Connect(function()
    task.wait(0.4)
    pcall(pullChar)
end)

local function parentGui(g)
    local ok = false
    pcall(function()
        if gethui then g.Parent = gethui() ok = true end
    end)
    if not ok then pcall(function() g.Parent = S.CG ok = true end) end
    if not ok then g.Parent = LP:WaitForChild("PlayerGui") end
end

